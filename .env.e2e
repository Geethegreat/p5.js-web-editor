# E2E test environment.
#
# Copied into .env by .github/workflows/e2e.yml (and can be copied the same
# way for local E2E runs). Everything below is unchanged from .env.example
# except where noted — those placeholder values are fine for E2E since
# nothing here needs to reach a real AWS/GitHub/Google/Mailgun account,
# it just needs to be non-empty so the app's startup checks pass.

# --- unchanged from .env.example ---
API_URL=/editor
AWS_ACCESS_KEY=<your-aws-access-key>
AWS_REGION=<your-aws-region>
AWS_SECRET_KEY=<your-aws-secret-key>
CORS_ALLOW_LOCALHOST=true
EMAIL_SENDER=<transactional-email-sender>
EMAIL_VERIFY_SECRET_TOKEN=whatever_you_want_this_to_be_it_only_matters_for_production
EXAMPLE_USER_EMAIL=examples@p5js.org
EXAMPLE_USER_PASSWORD=hellop5js
GG_EXAMPLES_USERNAME=generativedesign
GG_EXAMPLES_EMAIL=benedikt.gross@generative-gestaltung.de
GG_EXAMPLES_PASS=generativedesign
GITHUB_ID=<your-github-client-id>
GITHUB_SECRET=<your-github-client-secret>
GOOGLE_ID=<your-google-client-id> (use google+ api)
GOOGLE_SECRET=<your-google-client-secret> (use google+ api)
MAILGUN_DOMAIN=<your-mailgun-domain>
MAILGUN_KEY=<your-mailgun-api-key>
ML5_LIBRARY_USERNAME=ml5
ML5_LIBRARY_EMAIL=examples@ml5js.org
ML5_LIBRARY_PASS=helloml5
PORT=8000
PREVIEW_PORT=8002
EDITOR_URL=http://localhost:8000
PREVIEW_URL=http://localhost:8002
S3_BUCKET=<your-s3-bucket>
S3_BUCKET_URL_BASE=<alt-for-s3-url>
SESSION_SECRET=whatever_you_want_this_to_be_it_only_matters_for_production
TRANSLATIONS_ENABLED=true
UI_ACCESS_TOKEN_ENABLED=false
UPLOAD_LIMIT=250000000

# --- E2E-specific overrides/additions ---

# Dedicated database, separate from local dev's p5js-web-editor, so E2E
# runs (which create real users/projects) never touch real dev data, and
# e2e/global.teardown.ts can safely drop it
# before/after a run.
MONGO_URL=mongodb://localhost:27017/p5js-web-editor-test

# Signup always attempts to send a verification email, and 500s the whole
# request if that fails (see server/utils/mail.ts). CI can only ever have
# fake Mailgun credentials above, so that send always fails. This flag
# makes mail.ts skip the real network call instead of erroring — it's a
# workaround, not the final design (see PR discussion on simulating an
# actual verification-link click instead); remove this once that lands.
E2E_TESTING=true
